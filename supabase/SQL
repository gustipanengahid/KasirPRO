-- ==========================================
-- 7. FUNGSI ATOMIK CHECKOUT KASIR (RPC)
-- ==========================================
CREATE OR REPLACE FUNCTION public.process_checkout(
  p_transaction_id TEXT,
  p_invoice_number TEXT,
  p_sub_total NUMERIC,
  p_discount_total NUMERIC,
  p_tax_total NUMERIC,
  p_total NUMERIC,
  p_payment_method TEXT,
  p_cashier_id TEXT,
  p_cashier_name TEXT,
  p_items JSONB,
  p_cash_amount NUMERIC DEFAULT 0,
  p_change_amount NUMERIC DEFAULT 0
)
RETURNS VOID
LANGUAGE plpgsql
SECURITY DEFINER SET search_path = public, extensions
AS $$
DECLARE
  item JSONB;
  v_product_id TEXT;
  v_qty NUMERIC;
  v_current_stock NUMERIC;
BEGIN
  FOR item IN SELECT * FROM jsonb_array_elements(p_items)
  LOOP
    v_product_id := COALESCE(item->>'productId', item->>'id');
    v_qty := (item->>'qty')::NUMERIC;

    SELECT stock INTO v_current_stock
    FROM public.items
    WHERE id::TEXT = v_product_id
    FOR UPDATE;

    IF v_current_stock IS NULL THEN
      RAISE EXCEPTION 'Produk dengan ID % tidak ditemukan di database.', v_product_id;
    END IF;

    IF v_current_stock < v_qty THEN
      RAISE EXCEPTION 'Stok tidak mencukupi untuk produk ID %. Sisa stok: %', v_product_id, v_current_stock;
    END IF;

    UPDATE public.items
    SET stock = stock - v_qty,
        updated_at = NOW()
    WHERE id::TEXT = v_product_id;
  END LOOP;

  INSERT INTO public.transactions (
    id,
    invoice_number,
    sub_total,
    discount_total,
    tax_total,
    total,
    total_amount,
    cash_amount,
    change_amount,
    payment_method,
    cashier_id,
    cashier_name,
    items_json,
    created_at
  ) VALUES (
    p_transaction_id,
    p_invoice_number,
    p_sub_total,
    p_discount_total,
    p_tax_total,
    p_total,
    p_total,
    p_cash_amount,
    p_change_amount,
    p_payment_method,
    p_cashier_id,
    p_cashier_name,
    p_items,
    NOW()
  );
END;
$$;

-- Berikan hak akses eksekusi RPC yang diizinkan saja
GRANT EXECUTE ON FUNCTION public.process_checkout TO authenticated;
GRANT EXECUTE ON FUNCTION public.admin_reset_user_password TO authenticated;


